<h1><%= title %></h1>
<table class="table table-bordered border-primary">
  <thead>
    <tr>
      <th style="width: 20%;">작성자</th>
      <th style="width: 60%;">제목</th>
      <th style="width: 20%;">날짜</th>
    </tr>
  </thead>
  <tbody>
    <% if (results && results.length > 0) { %>
      <% results.forEach((post) => { %>
        <tr>
          <td><%= post.loginid %></td>
          <td>
            <a href="/board/detail/<%= post.board_id %>/<%= pNum %>">
              <%= post.title %>
            </a>
          </td>
          <td><%= post.date %></td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<% if (!results || results.length === 0) { %>
    <p>글쓰기 버튼으로 글을 작성하세요.</p>
<% } %>

<div class="mb-3">
  <% 
    var j = 1;
    while (j <= totalPages) {
      if (j == pNum) { 
  %>
        <span style="font-weight : bold;"><%= j %></span>&nbsp;&nbsp;
  <% 
      } else { 
  %>
        <span><a href="/board/view/<%= btname[0].type_id %>/<%= j %>" style="text-decoration: none;"><%= j %></a></span>&nbsp;&nbsp;
  <% 
      }
      j++;
    } 
  %>
</div>

<div class="d-grid gap-2 d-md-flex justify-content-md-end mt-3">
  <% if (cls === 'MNG' || (cls === 'CST' && write_YN === 'Y')) { %>
    <a href="/board/create/<%= type_id %>" class="btn btn-info text-white me-md-2">
      글쓰기
    </a>
  <% } %>
</div>