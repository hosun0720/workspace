<div class="container">
  
  <table class="table table-bordered border-primary table-hover" style="text-align: center">
    <thead class="table-primary">
      <tr>
        <th>대분류</th>
        <th>대분류명</th>
        <th>소분류</th>
        <th>소분류명</th>
        <th>시작일</th>
        <th>종료일</th>
        <th colspan="2"></th>
      </tr>
    </thead>
    <tbody>
      <% if (results && results.length > 0) { %>
        <% results.forEach((item) => { %>
          <tr>
            <td><%= item.main_id %></td>
            <td><%= item.main_name %></td>
            <td><%= item.sub_id %></td>
            <td><%= item.sub_name %></td>
            <td><%= item.start %></td>
            <td><%= item.end %></td>
            <td>
              <a href="/code/update/<%= item.main_id %>/<%= item.sub_id %>/<%= item.start %>/<%= item.end %>" 
                 style="text-decoration: none">수정</a>
            </td>
            <td>
              <a href="/code/delete/<%= item.main_id %>/<%= item.sub_id %>/<%= item.start %>/<%= item.end %>" 
                 style="text-decoration: none"
                 onclick="return confirm('정말로 삭제하시겠습니까?')">삭제</a>
            </td>
          </tr>
        <% }) %>
      <% } %>
      </tbody>
  </table>

  <% if (!results || results.length === 0) { %>
      <p>자료가 없으니 코드 추가 버튼으로 코드를 추가해 주십시오.</p>
  <% } %>

    <a href="/code/create">
      <button class="btn btn-primary">코드 추가</button>
    </a>

</div>