<div class="container mt-4">
  <table class="table table-bordered border-primary table-hover mb-0" style="text-align: center; vertical-align: middle;">
    <thead class="table-primary">
      <tr style="text-align: center; vertical-align: middle;">
        <th>고객ID</th>
        <th>고객명</th>
        <th>상품ID</th>
        <th>상품명</th>
        <th>구매일</th>
        <th>가격</th>
        <th>포인트</th>
        <th>구매량</th>
        <th>총가격</th>
        <th>지불여부</th>
        <th>취소여부</th>
        <th>환불여부</th>
        <th colspan="2"></th>
      </tr>
    </thead> 
    
    <% if (typeof results !== 'undefined' && results.length > 0) { %>
      <tbody>
        <% results.forEach((item) => { %>
          <tr>
            <td><%= item.loginid %></td>
            <td><%= item.user_name %></td>
            
            <td><%= item.prod_id %></td>
            <td><%= item.prod_name %></td>
            
            <td><%= item.date %></td>
            <td><%= item.price ? item.price.toLocaleString() : 0 %> 원</td>
            <td><%= item.point ? item.point.toLocaleString() : 0 %></td>
            <td><%= item.qty %></td>
            <td><%= item.total ? item.total.toLocaleString() : 0 %> 원</td>
            
            <td><%= item.payYN %></td>
            <td><%= item.cancel %></td>
            <td><%= item.refund ? item.refund : 'N' %></td>
            
            <td>
              <a href="/purchaseupdate/<%= item.purchase_id %>" style="text-decoration: none;">수정</a>
            </td>
            <td>
              <a href="/purchasedelete/<%= item.purchase_id %>" style="text-decoration: none;" onclick="if(confirm('정말로 삭제하시겠습니까?')==false) return false">삭제</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    <% } %>
  </table>

  <% if (typeof results === 'undefined' || results.length === 0) { %>
    <p class="text-muted text-center style-p" style="padding: 30px 0; font-size: 1.1rem; border: 1px solid #dee2e6; border-top: none;">
      구매 내역 데이터가 존재하지 않습니다.
    </p>
  <% } %>
</div>