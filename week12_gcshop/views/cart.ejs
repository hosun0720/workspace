<script>
  function actionCheck(event) {
    var tempOfCheck = 0;
    $("input[name=cart_ids]:checked").each(function() {
      tempOfCheck += 1;
    });
    
    var numOfCheck = document.getElementById('total');
    numOfCheck.value = tempOfCheck;
  }
  function checkSubmit(actionType) {
    var totalChecked = parseInt(document.getElementById('total').value);
    var form = document.getElementById('cartForm');

    if (totalChecked === 0) {
      if (actionType === 'purchase') {
        alert("구매할 상품을 선택해 주세요");
      } else if (actionType === 'delete') {
        alert("삭제할 상품을 선택해 주세요");
      }
      return false; 
    }

    if (actionType === 'delete') {
      if (confirm('정말로 삭제하시겠습니까?') == false) {
        return false;
      }
      form.action = '/purchase/cart/delete_process';
    } 
    else if (actionType === 'purchase') {
      form.action = '/purchase/cart/purchase_process';
    }

    return true; 
  }
</script>

<div class="container mt-4">
  <form id="cartForm" method="post">
    <table class="table table-bordered border-primary table-hover" style="text-align: center; vertical-align: middle;">
      <thead class="table-primary">
        <tr>
          <th>구매선택</th>
          <th>상품</th>
          <th>상품명</th>
          <th>단가</th>
          <th>담은날</th>
          <th>수량</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof results !== 'undefined' && results.length > 0) { %>
          <% results.forEach((item) => { %>
            <tr>
              <td>
                <input type="checkbox" name="cart_ids" value="<%= item.cart_id %>" onClick="actionCheck(event)">
              </td>
              <td>
                <a href="/detail/<%= item.prod_id %>" style="text-decoration: none;">
                  <img src="/images/<%= item.prod_image ? item.prod_image : 'no-image.jpg' %>" style="width:100px; height:100px; object-fit: cover; border-radius: 5px;">
                </a>
              </td>
              <td><%= item.prod_name %></td>
              <td><%= item.prod_price ? item.prod_price.toLocaleString() : 0 %> 원</td>
              <td><%= item.date %></td>
              <td>
                <input type="number" name="qty_<%= item.cart_id %>" value="1" min="1" class="form-control form-control-sm" style="width: 80px; margin: 0 auto;">
              </td> 
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" style="padding: 20px;" class="text-muted">장바구니가 비어 있습니다.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-5">
      <button class="btn btn-outline-primary btn-sm" type="submit" onclick="return checkSubmit('purchase')">결제</button>
      
      <input type="hidden" id="total" name="numOfCheck" value="0"> 
      
      <button class="btn btn-outline-primary btn-sm" type="submit" onclick="return checkSubmit('delete')">삭제</button>
      
      <a href="/" class="btn btn-outline-primary btn-sm">상품 목록 돌아가기</a>
    </div>
  </form>
</div>