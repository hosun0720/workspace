<div class="container mt-4">
  <table class="table table-bordered border-primary table-hover mb-0" style="text-align: center; vertical-align: middle;">
    <thead class="table-primary">
      <tr>
        <th>loginid</th>
        <th>고객명</th>
        <th>상품id</th>
        <th>상품명</th>
        <th>일자</th>
        <th colspan="2"></th>
      </tr>
    </thead> 
    
    <% if (typeof results !== 'undefined' && results.length > 0) { %>
      <tbody>
        <% results.forEach((item) => { %>
          <tr>
            <td><%= item.loginid %></td>
            <td><%= item.user_name %></td>
            <td><%= item.prod_id %></td>
            <td><%= item.prod_name %></td>
            <td><%= item.date %></td>
            <td>
              <a href="/cartupdate/<%= item.cart_id %>" style="text-decoration: none;">수정</a>
            </td>
            <td>
              <a href="/cartdelete/<%= item.cart_id %>" style="text-decoration: none;" onclick="if(confirm('정말로 삭제하시겠습니까?')==false) return false">삭제</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    <% } %>
  </table>

  <% if (typeof results === 'undefined' || results.length === 0) { %>
    <p class="text-muted text-center style-p" style="padding: 30px 0; font-size: 1.1rem; border: 1px solid #dee2e6; border-top: none;">
      장바구니 데이터가 존재하지 않습니다.
    </p>
  <% } %>
</div>