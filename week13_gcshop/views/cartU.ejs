<div class="container mt-4"> 
  <h2>cart 테이블 수정</h2>
  
  <form action="/cartupdate_process" method="post">
    
    <div class="mb-3"> 
      <input type="hidden" name="cart_id" value="<%= c.cart_id %>" />
    </div>
    
    <div class="mb-3">
      <label class="form-label" for="id" >고객</label> 
      <select name="loginid" id="id"  style="width: 150px;">
        <% if (typeof customers !== 'undefined') { %>
          <% customers.forEach((customer) => { %>
            <option value="<%= customer.loginid %>" <%= customer.loginid === c.loginid ? 'selected' : '' %>>
              <%= customer.name %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </div>
    
    <div class="mb-3">
      <label class="form-label" for="id2" >상품</label> 
      <select name="prod_id" id="id2"  style="width: 400px;">
        <% if (typeof products !== 'undefined') { %>
          <% products.forEach((product) => { %>
            <option value="<%= product.prod_id %>" <%= product.prod_id === c.prod_id ? 'selected' : '' %>>
              <%= product.name %>
            </option>
          <% }) %>
        <% } %>
      </select>
    </div>
    
    <div class="mb-3">
      <label class="form-label" for="id3" >날짜</label> 
      <input class="form-control" type="text" id="id3" name="date" value="<%= c.date %>" readonly style="width:300px; background-color:rgb(220, 220, 220);"/>
    </div>
    
    <button class="btn btn-outline-primary btn-sm" type="submit">수정</button>
    <a href="/cartview" class="btn btn-outline-primary btn-sm">카트 목록 돌아가기</a>
  </form>
</div>